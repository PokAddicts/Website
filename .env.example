# Copy this file to .env and fill in your published Google Sheet CSV URL.
# See scripts/sync-products.mjs for the full setup instructions and sheet schema.
PRODUCTS_SHEET_CSV_URL=

# Telegram bot notifications (currently wired up for the Restoration booking form only).
# Create a bot via @BotFather to get a token, and message @userinfobot to get your chat ID.
# TEST-ONLY setup: this token ships in the public JS bundle — see src/utils/telegram.ts.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
